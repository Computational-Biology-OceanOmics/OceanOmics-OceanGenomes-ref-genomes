/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Computational-Biology-OceanOmics/OceanGenomes-refgenomes Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1 }
    memory = { 6.GB }
    time   = { 4.h }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 6.GB }
        time   = { 4.h }
    }
    withLabel:process_low {
        cpus   = { 8 }
        memory = { 50.GB  }
        time   = { 4.h   }
    }
    withLabel:process_medium {
        cpus   = { 64 }
        memory = { 150.GB }
        time   = { 8.h }
    }
    withLabel:process_high {
        cpus   = { 128 }
        memory = { 230.GB}
        time   = { 24.h }
    }
    withLabel:process_long {
        time   = { 96.h  }
    }
    withLabel:process_high_memory {
        memory = { 500.GB }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName:CUSTOM_DUMPSOFTWAREVERSIONS {
        cache = false
    }
    withName:HIFIADAPTERFILT {
        cpus   = { 16 }
        memory = { 8.GB }
        time   = { 16.h }
    }
    // Memory retry escalation below targets processes whose RAM use scales with
    // genome size / HiC read depth (assembly, k-mer counting, scaffolding, HiC
    // sorting, decontamination scanning). Setonix queue ceilings (from `sinfo`):
    // work ≈ 239 GB, highmem ≈ 996 GB. Attempt 2 escalates memory, switching to
    // the highmem queue where attempt-1 values are already near the work ceiling.
    withName:MERYL_COUNT {
        cpus   = { 64 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 200.GB : 460.GB }
        time   = { 24.h }
    }

    withName:HIFIASM_SOLO {
        cpus   = { 128 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 230.GB : 460.GB }
        time   = { 24.h }
    }
    withName:HIFIASM {
        cpus   = { 128 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 230.GB : 460.GB }
        time   = { 24.h }
    }
    withName:BUSCO_BUSCO {
        cpus   = { 16 }
        memory = { task.attempt == 1 ? 80.GB : 230.GB }
        time   = { 8.h }
    }
    withName:BUSCO_BUSCO_FINAL {
        cpus   = { 32 }
        memory = { task.attempt == 1 ? 80.GB : 230.GB }
        time   = { 8.h }
    }
    withName:MERQURY {
        cpus   = { 8 }
        memory = { task.attempt == 1 ? 40.GB : 150.GB }
        time   = { 4.h }
    }
    withName:MERQURY_FINAL {
        cpus   = { 8 }
        memory = { task.attempt == 1 ? 40.GB : 150.GB }
        time   = { 4.h }
    }
    withName:SAMTOOLS_FAIDX {
        cpus   = { 16 }
        memory = { 32.GB }
        time   = { 4.h }
    }
    withName:CUT {
        cpus   = { 16 }
        memory = { 32.GB }
        time   = { 4.h }
    }
    withName:BWA_INDEX {
        cpus   = { 16 }
        memory = { 32.GB }
        time   = { 4.h }
    }
    withName:BWA_MEM {
        cpus   = { 16 }
        memory = { task.attempt == 1 ? 32.GB : 150.GB }
        time   = { 15.h }
    }
    withName:PAIRTOOLS_PARSE {
        cpus   = { 16 }
        memory = { task.attempt == 1 ? 64.GB : 230.GB }
        time   = { 14.h }
    }
    withName:PAIRTOOLS_SORT {
        queue  = 'highmem'
        cpus   = { 16 }
        memory = { task.attempt == 1 ? 400.GB : 700.GB }
        time   = { 14.h }
    }
    withName:PAIRTOOLS_DEDUP {
        cpus   = { 32 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 230.GB : 460.GB }
        time   = { 14.h }
    }
    withName:PAIRTOOLS_SPLIT {
        cpus   = { 32 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 230.GB : 460.GB }
        time   = { 14.h }
    }
    withName:SAMTOOLS_SORT {
        cpus   = { 32 }
        queue  = { task.attempt > 1 ? 'highmem' : 'work' }
        memory = { task.attempt == 1 ? 230.GB : 460.GB }
        time   = { 15.h }
    }
    withName:SAMTOOLS_INDEX {
        cpus   = { 32 }
        memory = { task.attempt == 1 ? 64.GB : 230.GB }
        time   = { 14.h }
    }
    withName:FCS_FCSGX_HAP1 {
        queue   = 'highmem'
        cpus    = { 32 }
        memory  = { task.attempt == 1 ? 512.GB : 900.GB }
        time    = { 4.h }
    }
    withName:FCS_FCSGX_HAP2 {
        queue   = 'highmem'
        cpus    = { 32 }
        memory  = { task.attempt == 1 ? 512.GB : 900.GB }
        time    = { 4.h }
    }
    withName:FCS_FCSGX_SH {
        queue   = 'highmem'
        cpus    = { 32 }
        memory  = { task.attempt == 1 ? 512.GB : 900.GB }
        time    = { 4.h }
    }
    withName:SALSA {
        cpus   = { 24 }
        memory = { task.attempt == 1 ? 80.GB : 230.GB }
        time   = { 8.h }
    }

    withName:MINIMAP2_ALIGN {
        cpus   = { 48 }
        memory = { task.attempt == 1 ? 96.GB : 230.GB }
        time   = { 8.h }
    }

    withName:BEDTOOLS_GENOMECOV {
        cpus   = { 24 }
        memory = { 64.GB }
        time   = { 4.h }
    }

    withName:TIDK {
        cpus   = { 48 }
        memory = { task.attempt == 1 ? 96.GB : 230.GB }
        time   = { 4.h }
    }

    withName:PRETEXTMAP2 {
        cpus   = { 8 }
        memory = { 20.GB }
        time   = { 2.h }
    }

    withName:YAHS {
        cpus   = { 48 }
        memory = { task.attempt == 1 ? 96.GB : 230.GB }
        time   = { 4.h }
    }
}
